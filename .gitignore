# ─── Flutter ───
#
# The Flutter toolchain output. `build/` and `.dart_tool/` are generated on
# every `flutter build`/`test`/`pub get` and are machine-specific.
#
# The legacy MinGW build (Makefile) writes its .o files in-tree next to their
# sources (src/, lib/, lib/lua/, third_party/imgui/) and its exe at the repo
# root — none of that is under build/, so the rules above stay untouched.
build/
.dart_tool/
.flutter-plugins-dependencies

# Generated localizations and the untranslated-key report (l10n.yaml).
lib/l10n/app_localizations*.dart
l10n_untranslated.json

# NOTE: pubspec.lock is deliberately NOT ignored. TaskPin is an application,
# not a library, so the lockfile is committed for reproducible builds — the
# same reason version.txt is pinned.

# `windows/generated_plugins_local.cmake` is a machine-specific workaround,
# generated by tool/generate_plugins_cmake.py. It hardcodes absolute pub-cache
# paths (C:/Users/<name>/AppData/...) and exists only because this machine
# cannot traverse the reparse points Flutter puts in
# windows/flutter/ephemeral/.plugin_symlinks/. CI runners CAN traverse them,
# so `windows/CMakeLists.txt` falls back to Flutter's own
# flutter/generated_plugins.cmake when this file is absent. Committing it would
# break the build for everyone else, so it stays untracked.
windows/generated_plugins_local.cmake

# Per-package Flutter output. The two packages under packages/ have their own
# .gitignore files; these cover them even if one is missing.
packages/*/.dart_tool/
packages/*/.flutter-plugins-dependencies
packages/*/build/

# Native CMake build trees (native/engine/build*, native/win/build*).
# These are out-of-source scratch dirs for the standalone harness builds; the
# Flutter build has its own tree under build/.
native/*/build*/

# Ad-hoc probe tests written while bringing a feature up. They import real
# code but assert nothing worth keeping; the durable tests live beside them.
test/_scratch/

# Claude Code local settings (per-machine permissions).
.claude/settings.local.json

# Local debugging leftovers: screenshots of the taskbar, run logs.
bar_shot_*.png
flutter_*.log

# Screenshots and logs captured while debugging the UI by hand.
ui_*.png
taskbar_now.png
taskpin_raise.log
.tp_prev_session.txt
