platform :osx, '12.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))

  # TaskPin's own native macOS code: the NSStatusItem bar renderer
  # (native/mac/StatusItemView.swift), the `taskpin/bar` channel
  # (StatusItemPlugin.swift), the Flutter popover (PopoverHost.swift) and the
  # Phase 6 dialog window effects (DialogWindowStyles.swift).
  #
  # A local pod rather than three entries hand-added to
  # macos/Runner.xcodeproj/project.pbxproj: a broken pbxproj is worse than a
  # documented manual step, and `flutter build macos` already runs `pod install`
  # on this template, so this line is the whole wiring. The podspec globs every
  # .swift in that directory, so adding a file needs no build-file change at all.
  # See native/mac/taskpin_bar.podspec for the full reasoning.
  pod 'taskpin_bar', :path => '../native/mac'

  # The Lua engine itself (native/engine): taskpin_lua.c, tp_engine.c,
  # tp_json.c, the macOS platform TUs and the vendored Lua sources. Linked as
  # a dynamic framework so its `tp_*` entry points are in the process and
  # Dart's `DynamicLibrary.process()` can resolve them.
  #
  # The podspec sits at the repo root because CocoaPods only globs files under
  # the pod root, and the engine needs both native/engine/* and lib/lua/*;
  # their common ancestor is the root. See taskpin_engine.podspec.
  pod 'taskpin_engine', :path => '..'

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
  end
end
